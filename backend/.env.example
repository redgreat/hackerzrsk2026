# 复制为 backend/.env 后填写；.env 含密钥，已加入 .gitignore，禁止提交。
# 嵌套配置使用双下划线，例如 LLM__API_KEY。

# dev / test / prod（prod 禁用 stub 模型和开发登录）
APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://coach:coach@127.0.0.1:5432/ai_coach
JWT_SECRET=please-change-to-a-random-string-at-least-32-chars
DEV_LOGIN_ENABLED=true
# 可查看全员统计的工号（JSON 数组）；留空则任何登录用户可看聚合数据
ADMIN_USERIDS=[]
CORS_ORIGINS=["http://localhost:5173"]
MASK_PII=true
MANUAL_COACHING_COST_YUAN=25

# ---------- 大模型（OpenAI 兼容接口）----------
# provider=stub 时无需密钥，用于开发联调
LLM__PROVIDER=stub
# 示例：DeepSeek  https://api.deepseek.com/v1          模型 deepseek-chat
# 示例：通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
LLM__BASE_URL=
LLM__API_KEY=
LLM__MODEL=deepseek-chat
# 按用途覆盖模型（可选），如教练报告用更强的模型
# LLM__COACH__MODEL=deepseek-chat
# LLM__CUSTOMER__TEMPERATURE=0.8
# 厂商额外参数（JSON），如百炼关闭深度思考：{"enable_thinking": false}
# LLM__EXTRA_BODY={"enable_thinking": false}
# 单价（元/百万 token），用于成本统计
LLM__PRICING={"deepseek-chat": {"input": 2, "output": 8}}

# ---------- 向量模型（知识库 RAG，可选）----------
EMBEDDING__ENABLED=false
EMBEDDING__BASE_URL=
EMBEDDING__API_KEY=
EMBEDDING__MODEL=text-embedding-v3
EMBEDDING__DIMENSIONS=1024

# ---------- 语音（可选）----------
# none / openai（OpenAI 兼容 /audio/transcriptions、/audio/speech）/ stub
SPEECH__ASR_PROVIDER=none
SPEECH__TTS_PROVIDER=none
SPEECH__BASE_URL=
SPEECH__API_KEY=
SPEECH__ASR_MODEL=whisper-1
SPEECH__TTS_MODEL=tts-1
SPEECH__TTS_VOICE=alloy
SPEECH__ASR_PRICE_PER_MINUTE=0
SPEECH__TTS_PRICE_PER_10K_CHARS=0

# ---------- 企业微信自建应用 ----------
WECOM__CORP_ID=
WECOM__AGENT_ID=
WECOM__SECRET=
